# Naarisa backend environment — copy to Backend/.env (gitignored) and fill in.
# Production values live in the Render dashboard: service "naarisa-backend-main" → Environment.
# After taking over the project, ROTATE every secret below (the previous team has copies).

# ── Server ───────────────────────────────────────────────────────────────────
# Render sets PORT itself — only needed locally
PORT=3000
# Extra sites allowed to call this API (comma-separated), e.g. a new Vercel URL
CORS_ORIGINS=
# FREE Render instances only: this server's own public URL, pinged every 30 s so it
# doesn't sleep (sleeping also stops the scheduled jobs). Leave empty on paid instances.
KEEP_ALIVE_URL=

# ── Database (REQUIRED) ─ MongoDB Atlas → Database → Connect → Drivers ──────────
# Must be a replica set (any Atlas cluster is) — checkout uses transactions.
MONGO_URI=

# ── Auth (REQUIRED) ─ long random string, unique to this environment (never reuse
# it as the Razorpay webhook secret); changing it logs everyone out once ──
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ── Razorpay ─ Dashboard → Account & Settings → API Keys (test/live mode) ────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Account & Settings → Webhooks → (webhook for /api/payment/razorpay) → secret
# Events: payment.captured, order.paid
RAZORPAY_WEBHOOK_SECRET=

# ── ImageKit (REQUIRED to boot) ─ Dashboard → Developer options → API keys ───
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/<your_id>

# ── Resend (email; REQUIRED to boot) ─ resend.com → API Keys; domain naarisa.com must be verified
RESEND_API_KEY=
RESEND_FROM_EMAIL=Naarisa <orders@naarisa.com>
CONTACT_EMAIL=naarisa23@gmail.com

# ── MSG91 (OTP + order SMS) ─ msg91.com → API → Auth key; Flows/Templates → flow IDs
MSG91_AUTH_KEY=
MSG91_OTP_FLOW=
MSG91_ORDER_CONFIRMATION_FLOW=
MSG91_ORDER_SHIPPED_FLOW=

# ── Twilio (SMS fallback when MSG91_ORDER_CONFIRMATION_FLOW is empty) ─ console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Shiprocket ─ app.shiprocket.in → Settings → API → Configure (create an API user)
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in/v1/external
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Settings → Pickup Addresses → the pickup location's nickname, exactly as shown
SHIPROCKET_PICKUP_LOCATION=
# Settings → API → Webhooks: URL https://<backend>/api/shipment/tracking/webhook,
# token = this value (sent as the x-api-key header). Webhook is rejected if this is empty.
SHIPROCKET_WEBHOOK_TOKEN=
